# ── Video Generation Backend ───────────────────────────────────────────────────
#
# Options:
#   replicate_svd      → Stable Video Diffusion via Replicate (default, no GPU needed)
#   replicate_minimax  → Minimax Video-01 via Replicate (full text-prompt support)
#   huggingface_local  → Local SVD XT inference (requires ~16 GB VRAM + diffusers)
#
VIDEO_BACKEND=replicate_minimax

# ── Replicate API Token ────────────────────────────────────────────────────────
# Required for replicate_svd and replicate_minimax backends.
# Get your free token at: https://replicate.com/account/api-tokens
#
REPLICATE_API_TOKEN=your_replicate_token_here

# ── HuggingFace Token (optional) ──────────────────────────────────────────────
# Only needed if you use the huggingface_local backend AND access gated models.
# Get your token at: https://huggingface.co/settings/tokens
#
HF_TOKEN=your_hf_token_here

# ── ComfyUI Backend (optional) ────────────────────────────────────────────────
# Required only when VIDEO_BACKEND=comfyui.
# ComfyUI must be running locally with WAN 2.2 models installed.
#
# Setup:
#   1. Install ComfyUI: https://github.com/comfyanonymous/ComfyUI
#   2. Install ComfyUI-VideoHelperSuite custom node (for VHS_VideoCombine)
#   3. Download WAN 2.2 i2v models into ComfyUI/models/ folders:
#        - models/diffusion_models/wan2.2_i2v_480p_14B_bf16.safetensors
#        - models/text_encoders/umt5-xxl-enc-bf16.safetensors
#        - models/vae/wan_2.2_vae.safetensors
#   4. Start ComfyUI, then set VIDEO_BACKEND=comfyui here.
#
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WAN_MODEL=wan2.2_i2v_480p_14B_bf16.safetensors
COMFYUI_WAN_CLIP=umt5-xxl-enc-bf16.safetensors
COMFYUI_WAN_VAE=wan_2.2_vae.safetensors
